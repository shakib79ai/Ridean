# ---- Core
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://ridean:ridean@localhost:5432/ridean
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
DEFAULT_CURRENCY=USD
# Minutes a quote stays bookable
QUOTE_TTL_MINUTES=15

# ---- First admin user (created by `npm run db:seed`)
ADMIN_EMAIL=admin@ridean.com
ADMIN_PASSWORD=change-me

# ---- Promotions
# code:percent-off pairs, e.g. RIDEAN10:10,WELCOME15:15 (funded from Ridean's earnings, never below cost)
PROMO_CODES=RIDEAN10:10

# ---- Payments
# stripe     = real Stripe (test or live keys)
# simulated  = no Stripe; payments succeed instantly (local development only)
PAYMENTS_MODE=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Supplier integrations
# live | sandbox | mock   (mock returns realistic sample offers without calling suppliers)
SUPPLIER_MODE=mock
SUPPLIER_TIMEOUT_MS=8000

# Curb (Ride Now, NYC)
SUPPLIER_CURB_BASE_URL=
SUPPLIER_CURB_API_KEY=
SUPPLIER_CURB_API_SECRET=

# SIXT (Rent a car)
SUPPLIER_SIXT_BASE_URL=
SUPPLIER_SIXT_API_KEY=
SUPPLIER_SIXT_PARTNER_ID=

# Mozio (Airport transfer, hourly)
SUPPLIER_MOZIO_BASE_URL=
SUPPLIER_MOZIO_API_KEY=

# Priceline (Rent a car, airport transfer)
SUPPLIER_PRICELINE_BASE_URL=
SUPPLIER_PRICELINE_API_KEY=
SUPPLIER_PRICELINE_REF_ID=

# Hertz (Rent a car)
SUPPLIER_HERTZ_BASE_URL=
SUPPLIER_HERTZ_API_KEY=
SUPPLIER_HERTZ_PARTNER_ID=

# Generic HTTP suppliers (local chauffeur partners) use SUPPLIER_<CODE>_BASE_URL / _API_KEY,
# where <CODE> is the supplier code in upper case, e.g. SUPPLIER_CITYCH_BASE_URL
